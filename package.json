{
  "name": "medsim-exam-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate && vite --host 0.0.0.0",
    "generate": "node --import tsx scripts/generate-exam-index.ts",
    "validate": "node --import tsx scripts/generate-exam-index.ts --check",
    "validate:dist": "node --import tsx scripts/validate-dist.ts",
    "migrate:poc": "node --import tsx scripts/migrate-poc.ts",
    "audit:legacy": "node --import tsx scripts/audit-legacy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "author:flow": "node --import tsx scripts/authoring/workflow-cli.ts",
    "author:hash": "node --import tsx scripts/authoring/cli.ts hash",
    "author:validate": "node --import tsx scripts/authoring/cli.ts validate",
    "author:gate": "node --import tsx scripts/authoring/cli.ts gate",
    "author:promote": "node --import tsx scripts/authoring/cli.ts promote",
    "author:generate": "node --import tsx scripts/authoring/generation-cli.ts generate",
    "author:import-generation": "node --import tsx scripts/authoring/generation-cli.ts import"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "^8.18.0",
    "jsdom": "^30.1.1",
    "parse5": "^8.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
